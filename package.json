{
  "name": "@noir-wallet/sdk",
  "version": "0.1.9",
  "description": "TypeScript SDK for Noir Wallet dApp integration",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./chains/zcash": {
      "types": "./dist/chains/zcash/index.d.ts",
      "import": "./dist/chains/zcash/index.mjs",
      "require": "./dist/chains/zcash/index.js"
    },
    "./chains/evm": {
      "types": "./dist/chains/evm/index.d.ts",
      "import": "./dist/chains/evm/index.mjs",
      "require": "./dist/chains/evm/index.js"
    },
    "./chains/bitcoin": {
      "types": "./dist/chains/bitcoin/index.d.ts",
      "import": "./dist/chains/bitcoin/index.mjs",
      "require": "./dist/chains/bitcoin/index.js"
    },
    "./chains/solana": {
      "types": "./dist/chains/solana/index.d.ts",
      "import": "./dist/chains/solana/index.mjs",
      "require": "./dist/chains/solana/index.js"
    },
    "./chains/near": {
      "types": "./dist/chains/near/index.d.ts",
      "import": "./dist/chains/near/index.mjs",
      "require": "./dist/chains/near/index.js"
    },
    "./chains/multichain": {
      "types": "./dist/chains/multichain/index.d.ts",
      "import": "./dist/chains/multichain/index.mjs",
      "require": "./dist/chains/multichain/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/chains/zcash/index.ts src/chains/evm/index.ts src/chains/bitcoin/index.ts src/chains/solana/index.ts src/chains/near/index.ts src/chains/multichain/index.ts --format cjs,esm --dts --out-dir dist --clean",
    "dev": "tsup src/index.ts src/chains/zcash/index.ts src/chains/evm/index.ts src/chains/bitcoin/index.ts src/chains/solana/index.ts src/chains/near/index.ts src/chains/multichain/index.ts --format cjs,esm --dts --out-dir dist --watch",
    "type-check": "tsc --noEmit",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "test:network": "pnpm run build && node --test tests/evm-network.test.mjs",
    "pack:dry": "npm pack --dry-run --ignore-scripts",
    "example:dev": "pnpm --filter @noir-wallet/example dev",
    "example:build": "pnpm --filter @noir-wallet/example build",
    "contracts:compile": "node contracts/compile.mjs",
    "contracts:deploy": "node contracts/deploy.mjs",
    "contracts:verify": "node contracts/verify-calls.mjs",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "solc": "^0.8.36",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "viem": "^2.55.19"
  },
  "keywords": [
    "noir",
    "wallet",
    "multi-chain",
    "zcash",
    "dapp",
    "web3",
    "crypto"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Noir Finance",
  "license": "MIT",
  "homepage": "https://noirwallet.github.io/noir-wallet-sdk/",
  "repository": {
    "type": "git",
    "url": "https://github.com/NoirWallet/noir-wallet-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/NoirWallet/noir-wallet-sdk/issues"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "bs58": "^6.0.0"
  },
  "private": false,
  "packageManager": "pnpm@10.33.4"
}
